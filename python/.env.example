# Redis（与 Spring Boot spring.data.redis 对齐）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1

# RustFS / MinIO（与 fish.rustfs 对齐）
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=<your-rustfs-access-key>
RUSTFS_SECRET_KEY=<your-rustfs-secret-key>
RUSTFS_BUCKET_DOCS=itops-docs

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_USER_KNOWLEDGE_COLLECTION=itops_user_knowledge
MILVUS_PUBLIC_KNOWLEDGE_COLLECTION=itops_public_knowledge
MILVUS_USER_MEMORY_COLLECTION=itops_user_memory
MILVUS_BATCH_SIZE=100

# MySQL：二选一（优先解析 DB_URL）
DB_URL=jdbc:mysql://localhost:3306/fish_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=<your-db-password>
# 若不使用 DB_URL，可拆开：
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=fish_agent

# Stream
FISH_DOC_INGEST_STREAM=fish:doc:ingest

# 嵌入（仅支持 Ollama，DashScope 已移除）
FISH_LLM_EMBEDDING_PROVIDER=OLLAMA
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Worker 专属
FISH_WORKER_CONSUMER_GROUP=fish-doc-worker-group
FISH_WORKER_CONCURRENCY=2
FISH_WORKER_CHUNK_SIZE=512
FISH_WORKER_CHUNK_OVERLAP=50
FISH_WORKER_BLOCK_MS=5000
FISH_WORKER_HEALTH_PORT=8091
FISH_WORKER_HEARTBEAT_SECONDS=30
FISH_WORKER_EMBED_MAX_RETRIES=3
FISH_WORKER_EMBED_BACKOFF_BASE=1.0
FISH_WORKER_EMBED_BACKOFF_MAX=30.0
